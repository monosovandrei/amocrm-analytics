{
  "name": "amocrm-analytics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "crm-control:browser-login": "node scripts/crm-control-browser-login.cjs",
    "dev": "npm run dev --workspace=@amocrm-analytics/api",
    "dev:web": "npm run dev --workspace=@amocrm-analytics/web",
    "build": "npm run build --workspace=@amocrm-analytics/api && npm run build --workspace=@amocrm-analytics/web",
    "typecheck": "npm run typecheck --workspace=@amocrm-analytics/api && npm run typecheck --workspace=@amocrm-analytics/web",
    "test": "npm test --workspace=@amocrm-analytics/api -- --runInBand",
    "slop-check": "node scripts/slop-check.mjs",
    "frontend:gate": "npm run slop-check && npm run typecheck --workspace=@amocrm-analytics/web",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "db:seed:rop-demo": "node prisma/seed-rop-demo.js"
  },
  "dependencies": {
    "@nestjs/platform-fastify": "11.2.3",
    "@prisma/client": "^5.22.0",
    "jszip": "^3.10.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "fastify": "5.12.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
