[Unit]
Description=amoCRM Analytics Export Worker
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/analytics/apps/api
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=WORKER_RECYCLE_RSS_MB=650
ExecStart=/usr/bin/node dist/export-worker.js
Restart=always
RestartSec=5
User=ameri
Group=ameri
MemoryHigh=700M
MemoryMax=850M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
