[Unit]
Description=amoCRM Analytics Report Worker
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/analytics/apps/api
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=REPORT_CACHE_REFRESH_BATCH_SIZE=3
Environment=REPORT_CACHE_STALE_QUEUE_BATCH_SIZE=0
Environment=REPORT_REFRESH_PROCESS_TIMEOUT_MS=300000
Environment=WORKER_RECYCLE_RSS_MB=650
ExecStart=/usr/bin/node --expose-gc dist/report-worker.js
Restart=always
RestartSec=5
User=ameri
Group=ameri
MemoryHigh=700M
MemoryMax=850M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
